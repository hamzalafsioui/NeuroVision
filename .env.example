# Copy this file to .env and fill in your values

# MLflow tracking server
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_CLASSIFICATION=brain_tumor_classification
MLFLOW_EXPERIMENT_DETECTION=brain_tumor_detection

# PostgreSQL for MLflow backend
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=passwoooooooord
POSTGRES_DB=mlflow
POSTGRES_PORT=5432

# FastAPI
API_PORT=8000
API_HOST=0.0.0.0

# Streamlit
STREAMLIT_PORT=8501
API_URL=http://api:8000

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:change_me@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=change_me_generate_with_python_cryptography
AIRFLOW__WEBSERVER__SECRET_KEY=change_me_random_string
AIRFLOW_PORT=8080

# Vast.ai (fill when you rent a GPU)
VAST_API_KEY=your_vast_api_key_here
VAST_INSTANCE_ID=your_instance_id_here
VAST_SSH_HOST=your_instance_ip_here
VAST_SSH_PORT=your_ssh_port_here
VAST_SSH_USER=root

# Paths inside containers
DATA_DIR=/app/data
MODELS_DIR=/app/models
